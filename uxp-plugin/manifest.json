{
  "manifestVersion": 5,
  "id": "com.miqahawkstudio.polishsubtitleai",
  "name": "Polish Subtitle AI",
  "version": "0.1.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "polishSubtitleAiPanel",
      "label": {
        "default": "Polish Subtitle AI"
      },
      "minimumSize": { "width": 300, "height": 460 },
      "maximumSize": { "width": 1200, "height": 2000 },
      "preferredDockedSize": { "width": 360, "height": 680 },
      "preferredFloatingSize": { "width": 380, "height": 720 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"],
          "species": ["chrome"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [1, 2],
          "theme": ["dark", "darkest"],
          "species": ["chrome"]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": false,
    "network": {
      "domains": "all"
    }
  },
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "light", "lightest"],
      "species": ["generic"]
    }
  ]
}
